    {
      "title": "Tree",
      "text": "Folders and items with unique codes, drag-and-drop moves and undo."
    },
    {
      "title": "Attributes",
      "text": "Typed input, favourite attribute orders and formulas."
    },
    {
      "title": "Templates",
      "text": "Personal attribute templates reusable in the catalog."
    },
    {
      "title": "External libraries",
      "text": "Read-only browsing and import into the catalog."
    }
