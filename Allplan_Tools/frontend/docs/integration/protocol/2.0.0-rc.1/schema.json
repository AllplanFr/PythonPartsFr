{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allplan:host-protocol:2.0.0-rc.1",
  "title": "Allplan host protocol 2.0 - candidate 1, not activated",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/event"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s\\u0000-\\u001f]+$"},
    "app_id": {"enum": ["smartcatalog", "vob_editor", "information_manager"]},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "attribute_number": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "enum_key": {"$ref": "#/$defs/attribute_number"},
    "empty": {"type": "object", "additionalProperties": false},
    "version": {"const": "2.0"},
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_version", "app_id", "session_id", "mode", "protocol_versions", "contract_release", "transport"],
      "properties": {
        "bootstrap_version": {"const": 1},
        "app_id": {"$ref": "#/$defs/app_id"},
        "session_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["protocol", "legacy"]},
        "protocol_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "contract_release": {"type": ["string", "null"]},
        "transport": {"enum": ["pywebview_dispatch", "webview2_host_object", "webview2_post_message", "pywebview_legacy", "aim_legacy"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "protocol"}}},
          "then": {
            "properties": {
              "protocol_versions": {"contains": {"const": "2.0"}},
              "contract_release": {"const": "2.0.0-rc.1"},
              "transport": {"enum": ["pywebview_dispatch", "webview2_host_object", "webview2_post_message"]}
            }
          },
          "else": {
            "properties": {
              "protocol_versions": {"maxItems": 0},
              "contract_release": {"type": "null"},
              "transport": {"enum": ["pywebview_legacy", "aim_legacy"]}
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "generation", "allplan_version", "verification_version", "country", "allplan_language", "application_language", "paths", "project_path", "catalog_user_path", "origin"],
      "properties": {
        "context_id": {"$ref": "#/$defs/id"},
        "generation": {"$ref": "#/$defs/generation"},
        "allplan_version": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}$"}]},
        "verification_version": {"type": "boolean"},
        "country": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z]{3}$"}]},
        "allplan_language": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z]{2,3}$"}]},
        "application_language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "paths": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "ETC": {"type": "string", "minLength": 1},
            "PRG": {"type": "string", "minLength": 1},
            "STD": {"type": "string", "minLength": 1},
            "PRJ": {"type": "string", "minLength": 1},
            "USR": {"type": "string", "minLength": 1},
            "TMP": {"type": "string", "minLength": 1}
          }
        },
        "project_path": {"type": ["string", "null"], "minLength": 1},
        "catalog_user_path": {"type": ["string", "null"], "minLength": 1},
        "origin": {"enum": ["standalone", "allplan"]}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "implementation", "availability", "reason_code"],
      "properties": {
        "command": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "implementation": {"enum": ["implemented", "not_implemented"]},
        "availability": {"enum": ["available", "unavailable", "not_applicable"]},
        "reason_code": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"implementation": {"const": "not_implemented"}}},
          "then": {"properties": {"availability": {"const": "unavailable"}, "reason_code": {"const": "not_implemented"}}}
        },
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {"properties": {"reason_code": {"type": "null"}}},
          "else": {"properties": {"reason_code": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "diagnostic_state": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_message_bytes", "max_pending_operations", "operation_retention_seconds", "operation_status_supported", "timeouts"],
      "properties": {
        "max_message_bytes": {"type": "integer", "minimum": 1},
        "max_pending_operations": {"type": "integer", "minimum": 0},
        "operation_retention_seconds": {"type": "integer", "minimum": 0},
        "operation_status_supported": {"type": "boolean"},
        "timeouts": {
          "type": "object", "additionalProperties": false,
          "required": ["control_ms", "read_ms", "write_ms", "dialog_ms"],
          "properties": {
            "control_ms": {"type": "integer", "minimum": 1},
            "read_ms": {"type": "integer", "minimum": 1},
            "write_ms": {"type": "integer", "minimum": 1},
            "dialog_ms": {"type": "null"}
          }
        }
      }
    },
    "handshake_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_versions", "client_version", "contract_release"],
      "properties": {
        "supported_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "client_version": {"type": "string", "minLength": 1},
        "contract_release": {"const": "2.0.0-rc.1"}
      }
    },
    "handshake_result": {
      "type": "object", "additionalProperties": false,
      "required": ["host_version", "supported_versions", "negotiated_version", "contract_release", "session_id", "app_id", "capabilities", "context", "diagnostic", "limits"],
      "properties": {
        "host_version": {"type": "string", "minLength": 1},
        "supported_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "contains": {"const": "2.0"}},
        "negotiated_version": {"const": "2.0"},
        "contract_release": {"const": "2.0.0-rc.1"},
        "session_id": {"$ref": "#/$defs/id"},
        "app_id": {"$ref": "#/$defs/app_id"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "context": {"$ref": "#/$defs/context"},
        "diagnostic": {"$ref": "#/$defs/diagnostic_state"},
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "path", "position"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"], "minLength": 1},
        "position": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false, "required": ["key", "label", "generated_key", "provenance"],
      "properties": {
        "key": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/enum_key"}]},
        "label": {"type": "string"},
        "generated_key": {"type": "boolean"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "if": {"properties": {"key": {"type": "null"}}},
      "then": {"properties": {"generated_key": {"const": false}}}
    },
    "typed_value": {
      "type": "object", "additionalProperties": false, "required": ["kind", "raw", "value"],
      "properties": {
        "kind": {"enum": ["text", "integer", "real", "boolean", "date", "time", "enumeration", "no_selection", "unknown"]},
        "raw": {"type": ["string", "null"]},
        "value": {}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "text"}}}, "then": {"properties": {"value": {"type": "string"}}}},
        {"if": {"properties": {"kind": {"const": "integer"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}}}},
        {"if": {"properties": {"kind": {"const": "real"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}}}},
        {"if": {"properties": {"kind": {"const": "boolean"}}}, "then": {"properties": {"value": {"type": "boolean"}}}},
        {"if": {"properties": {"kind": {"const": "date"}}}, "then": {"properties": {"value": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}},
        {"if": {"properties": {"kind": {"const": "time"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}}}},
        {"if": {"properties": {"kind": {"const": "enumeration"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/enum_key"}}}},
        {"if": {"properties": {"kind": {"const": "no_selection"}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "unknown"}}}, "then": {"properties": {"raw": {"type": "string"}, "value": {"type": "null"}}}}
      ]
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "severity", "category", "parameters", "message", "provenance", "related", "attribute_number", "uids", "suppression"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "category": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "message": {"type": "string", "minLength": 1},
        "provenance": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
        "related": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "attribute_number": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/attribute_number"}]},
        "uids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "suppression": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false, "required": ["key", "scopes"],
              "properties": {
                "key": {"type": "string", "pattern": "^uid_conflict_v1:[a-f0-9]{64}$"},
                "scopes": {"const": ["session", "persistent"]}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"anyOf": [{"properties": {"severity": {"const": "error"}}}, {"not": {"properties": {"code": {"const": "uid_conflict"}}}}]},
          "then": {"properties": {"suppression": {"type": "null"}}}
        },
        {
          "if": {"properties": {"code": {"const": "uid_conflict"}}},
          "then": {"properties": {"attribute_number": {"$ref": "#/$defs/attribute_number"}, "uids": {"minItems": 2}}}
        }
      ]
    },
    "confirmed_value": {
      "type": "object", "additionalProperties": false,
      "required": ["attribute_number", "value"],
      "properties": {"attribute_number": {"$ref": "#/$defs/attribute_number"}, "value": {"$ref": "#/$defs/typed_value"}}
    },
    "write_report": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "document_id", "submitted_document_revision", "saved_document_revision", "presentation_status", "confirmed_values", "failed_attributes", "unconfirmed_attribute_numbers", "verification"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/id"},
        "document_id": {"$ref": "#/$defs/id"},
        "submitted_document_revision": {"$ref": "#/$defs/id"},
        "saved_document_revision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "presentation_status": {"enum": ["not_requested", "confirmed", "failed", "unconfirmed"]},
        "confirmed_values": {"type": "array", "items": {"$ref": "#/$defs/confirmed_value"}},
        "failed_attributes": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["attribute_number", "code", "message"],
            "properties": {
              "attribute_number": {"$ref": "#/$defs/attribute_number"},
              "code": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        },
        "unconfirmed_attribute_numbers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/attribute_number"}},
        "verification": {"enum": ["none", "readback", "writer_acknowledgement"]}
      },
      "allOf": [
        {
          "if": {"properties": {"verification": {"const": "none"}}},
          "then": {"properties": {"confirmed_values": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"presentation_status": {"const": "confirmed"}}},
          "then": {"properties": {"saved_document_revision": {"$ref": "#/$defs/id"}}},
          "else": {"properties": {"saved_document_revision": {"type": "null"}}}
        }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"enum": ["invalid_message", "invalid_payload", "unsupported_protocol", "unknown_command", "not_implemented", "unsupported_operation", "source_unavailable", "configuration_error", "access_denied", "not_found", "invalid_data", "io_error", "write_error", "partial_write", "revision_conflict", "stale_context", "timeout", "operation_unknown", "resource_limit", "internal_error"]},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "if": {"properties": {"code": {"const": "partial_write"}}},
      "then": {"properties": {"details": {"$ref": "#/$defs/write_report"}, "retryable": {"const": false}}},
      "else": {"properties": {"details": {"$ref": "#/$defs/empty"}}}
    },
    "command": {"enum": ["host.handshake", "host.capabilities", "host.context", "diagnostic.get", "diagnostic.set", "diagnostic.open_logs"]},
    "base_message": {
      "type": "object",
      "required": ["protocol_version", "kind", "session_id", "app_id", "context_id", "generation"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/version"},
        "kind": {"enum": ["request", "response", "event"]},
        "session_id": {"$ref": "#/$defs/id"},
        "app_id": {"$ref": "#/$defs/app_id"},
        "context_id": {"type": "null"},
        "generation": {"type": "null"}
      }
    },
    "request": {
      "allOf": [
        {"$ref": "#/$defs/base_message"},
        {
          "properties": {"kind": {"const": "request"}, "request_id": {"$ref": "#/$defs/id"}, "command": {"$ref": "#/$defs/command"}, "payload": {"type": "object"}},
          "required": ["request_id", "command", "payload"]
        },
        {
          "if": {"properties": {"command": {"const": "host.handshake"}}},
          "then": {"properties": {"payload": {"$ref": "#/$defs/handshake_payload"}}},
          "else": {
            "if": {"properties": {"command": {"const": "diagnostic.set"}}},
            "then": {"properties": {"payload": {"$ref": "#/$defs/diagnostic_state"}}},
            "else": {"properties": {"payload": {"$ref": "#/$defs/empty"}}}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "response": {
      "allOf": [
        {"$ref": "#/$defs/base_message"},
        {
          "required": ["request_id", "command", "status", "operation_id", "result", "error"],
          "properties": {
            "kind": {"const": "response"},
            "request_id": {"$ref": "#/$defs/id"},
            "command": {"$ref": "#/$defs/command"},
            "status": {"enum": ["success", "cancelled", "error"]},
            "operation_id": {"type": "null"},
            "result": {},
            "error": {}
          }
        },
        {
          "if": {"properties": {"status": {"const": "success"}}},
          "then": {
            "properties": {"error": {"type": "null"}},
            "allOf": [
              {"if": {"properties": {"command": {"const": "host.handshake"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/handshake_result"}}}},
              {"if": {"properties": {"command": {"const": "host.capabilities"}}}, "then": {"properties": {"result": {"type": "object", "additionalProperties": false, "required": ["capabilities"], "properties": {"capabilities": {"$ref": "#/$defs/capabilities"}}}}}},
              {"if": {"properties": {"command": {"const": "host.context"}}}, "then": {"properties": {"result": {"type": "object", "additionalProperties": false, "required": ["context"], "properties": {"context": {"$ref": "#/$defs/context"}}}}}},
              {"if": {"properties": {"command": {"enum": ["diagnostic.get", "diagnostic.set"]}}}, "then": {"properties": {"result": {"$ref": "#/$defs/diagnostic_state"}}}},
              {"if": {"properties": {"command": {"const": "diagnostic.open_logs"}}}, "then": {"properties": {"result": {"type": "object", "additionalProperties": false, "required": ["opened"], "properties": {"opened": {"const": true}}}}}}
            ]
          },
          "else": {
            "properties": {"result": {"type": "null"}},
            "if": {"properties": {"status": {"const": "error"}}},
            "then": {"properties": {"error": {"$ref": "#/$defs/error"}}},
            "else": {"properties": {"error": {"type": "null"}, "command": {"const": "diagnostic.open_logs"}}}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "event": {
      "allOf": [
        {"$ref": "#/$defs/base_message"},
        {
          "required": ["event_id", "event", "payload"],
          "properties": {
            "kind": {"const": "event"},
            "event_id": {"$ref": "#/$defs/id"},
            "event": {"const": "diagnostic.state"},
            "payload": {"$ref": "#/$defs/diagnostic_state"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
